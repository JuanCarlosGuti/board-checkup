# Puerto (Render lo inyecta solo)
PORT=3000

# Credenciales de la app "Board Checkup" en el Centro de desarrollo de monday.
# El Client ID es publico: se sirve en /monday-app-association.json.
MONDAY_CLIENT_ID=7ce83fbbf1ecf2cbd2c545305396b442

# Estos DOS son secretos. En Render van como variables de entorno.
# Nunca deben entrar al repositorio.
MONDAY_SIGNING_SECRET=
MONDAY_CLIENT_SECRET=

# HSTS. Arrancamos conservador y lo subimos cuando lleve dias estable.
# El marketplace de monday exige HSTS; soporte dice "minimo un ano" (31536000).
HSTS_MAX_AGE=86400

# Tope de items que se leen en una invocacion sincrona de Sidekick.
# Medido: 500 items = ~1.650 ms desde Colombia, ~1.200 ms esperados desde Render US.
LIVE_SCAN_LIMIT=500
